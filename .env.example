# Evaluation Studio — Role-Based BYOK Environment Variables
# Copy to `.env` locally (never commit `.env` or real API keys to git).

# --- Role-Separated Keys (Preferred) ---
TARGET_API_KEY=
JUDGE_API_KEY=
EXTRACTOR_API_KEY=
FALLBACK_JUDGE_API_KEY=

# --- Provider Fallback Keys ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
SARVAM_API_KEY=

# --- Local OpenAI-Compatible / Ollama Endpoints ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional Cache Directory Override (defaults to user-owned platformdirs cache) ---
# EVAL_STUDIO_CACHE_DIR=
